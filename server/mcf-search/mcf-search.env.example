# /etc/mcf-search.env  (root:root, chmod 600). Read by systemd for mcf-search.service. Never commit real values.
MCF_SEARCH_HOST=127.0.0.1
MCF_SEARCH_PORT=8020
MCF_ALLOWED_ORIGINS=https://moundcityfinds.shop,https://www.moundcityfinds.shop
# Rakuten Advertising (Developer Portal > Applications: Client ID/Secret; SID from publisher dashboard)
RAKUTEN_CLIENT_ID=
RAKUTEN_CLIENT_SECRET=
RAKUTEN_SID=4781182
# FlexOffers (publisher dashboard > Tools > API, after approval)
FLEXOFFERS_API_KEY=
# Impact (partner dashboard > Settings > API: Account SID + Auth Token)
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
# Awin (Toolbox > Create-a-Feed download URL, CSV)
AWIN_FEED_URL=
# CJ (developers.cj.com personal access token; company CID; website PID)
CJ_PERSONAL_ACCESS_TOKEN=
CJ_COMPANY_ID=
CJ_WEBSITE_ID=
# Amazon Creators API (stub, disabled; needs Creators API eligibility)
CREATORS_CREDENTIAL_ID=
CREATORS_SECRET=
CREATORS_VERSION=
CREATORS_PARTNER_TAG=printsquad-20
